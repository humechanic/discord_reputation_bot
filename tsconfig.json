{
    "compilerOptions": {
        "target": "ES2020",
        "module": "Node16",
        "outDir": "./build",
        "rootDir": "./src",
        "baseUrl": "./src",
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "strict": true,
        "allowJs": true,
        "noImplicitAny": false,
        "skipLibCheck": true,
        "moduleResolution": "node16",
        "paths": {
            "@api/*": [
                "api/*"
            ],
            "@app/*": [
                "app/*"
            ],
            "@assets/*": [
                "assets/*"
            ],
            "@events/*": [
                "events/*"
            ],
            "@shared/*": [
                "shared/*"
            ],
            "@utils/*": [
                "utils/*"
            ],
        }
    },
    "include": [
        "src",
    ],
    "exclude": [
        "node_modules",
        "build",
        "db",
    ]
}