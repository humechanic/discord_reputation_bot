{
    "compilerOptions": {
        "target": "ES6",
        "module": "CommonJS",
        "outDir": "./build",
        "rootDir": ".",
        "baseUrl": "./src",
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "strict": true,
        "allowJs": true,
        "noImplicitAny": false,
        "skipLibCheck": true,
        "moduleResolution": "node",
        "paths": {
            "@api/*": [
                "./src/api/*"
            ],
            "@app/*": [
                "./src/app/*"
            ],
            "@assets/*": [
                "./src/assets/*"
            ],
            "@events/*": [
                "./src/events/*"
            ],
            "@shared/*": [
                "./src/shared/*"
            ],
            "@utils/*": [
                "./src/utils/*"
            ],
        }
    }
}