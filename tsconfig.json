{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "outDir": "./build",
        "rootDir": ".",
        "baseUrl": "./src",
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "strict": true,
        "allowJs": true,
        "noImplicitAny": false,
        "skipLibCheck": true,
        "moduleResolution": "node",
        "paths": {
            "@api/*": [
                "api/*"
            ],
            "@app/*": [
                "app/*"
            ],
            "@assets/*": [
                "assets/*"
            ],
            "@events/*": [
                "events/*"
            ],
            "@shared/*": [
                "shared/*"
            ],
            "@utils/*": [
                "utils/*"
            ],
        }
    },
    "include": [
        "src/**/*",
        "src/*",
    ],
    "exclude": [
        "node_modules",
        "build",
        "db",
    ]
}